# ============================================================
# Swing Trader — Environment Variables
# Copy this file to .env and fill in your credentials
# NEVER commit .env to git
# ============================================================

# Gmail SMTP (for SMS via carrier gateway — free)
GMAIL_ADDRESS=accufastadjusting@gmail.com
GMAIL_APP_PASSWORD=quna cbte kkwh qemu

# SMS recipients (carrier email-to-SMS gateways)
# T-Mobile:  number@tmomail.net
# Verizon:   number@vtext.com
# AT&T:      number@txt.att.net
TMOBILE_SMS=9132955881@tmomail.net
# VERIZON_SMS=1234567890@vtext.com    # optional second recipient

# Alternative: Twilio (uncomment if preferred)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# TWILIO_TO_NUMBER=+1xxxxxxxxxx

# ── Pre-Market Intelligence APIs (optional — system works without them) ──
# Finnhub: economic calendar, earnings, news, sentiment (60 calls/min free)
# Get free key at: https://finnhub.io/register
FINNHUB_API_KEY=

# FRED: VIX term structure (120 req/min free)
# Get free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
